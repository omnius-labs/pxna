# Settings read by compose.yaml. Create .env with `cp .env.example .env` and change the values you need.

# Host directory mounted at /libraries/contents in the container (absolute path). Required.
# It backs the "contents" library in config/pxna.toml. Add more libraries with compose.override.yaml.
PXNA_CONTENTS_DIR=/absolute/path/to/your/contents

# User the container runs as. Match the owner of the library (`id -u` / `id -g`).
# PXNA_UID=1000
# PXNA_GID=1000

# Address to listen on at the host. The default only accepts connections from the host itself.
# 0.0.0.0 exposes pxna to your network; use it only on a trusted network or behind HTTPS.
# PXNA_BIND=127.0.0.1

# Port to listen on at the host.
# PXNA_PORT=6050

# Time zone used for timeline aggregation.
# TZ=Asia/Tokyo
