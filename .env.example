# Settings read by compose.yaml. Create .env with `cp .env.example .env` and change the values you need.

# Host directory mounted over /libraries in the container (absolute path). Required.
PXNA_LIBRARY_DIR=/absolute/path/to/your/library

# User the container runs as. Match the owner of the library (`id -u` / `id -g`).
# PXNA_UID=1000
# PXNA_GID=1000

# Port to listen on at 127.0.0.1 on the host.
# PXNA_PORT=6050

# Time zone used for timeline aggregation.
# TZ=Asia/Tokyo
