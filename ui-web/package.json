        "hls.js": "^1.7.4",
        "i18next": "^26.5.12",
        "lucide-react": "^1.66.0",
        "next-themes": "^0.4.6",
        "openapi-fetch": "^0.17.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
