        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "hls.js": "^1.7.3",
        "lucide-react": "^1.59.0",
        "next-themes": "^0.4.6",
        "openapi-fetch": "^0.17.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0"
    },
