{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!**/dist", "!src/api/schema.d.ts", "!src/api/imageChannel.d.ts"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "linter": {
        "enabled": true
    },
    "overrides": [
        {
            "includes": ["src/index.css", "src/shadcn.css"],
            "assist": { "enabled": false },
            "formatter": { "enabled": false },
            "linter": { "enabled": false }
        },
        {
            "includes": ["src/components/ui/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "useFocusableInteractive": "off",
                        "useKeyWithClickEvents": "off",
                        "useSemanticElements": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off"
                    }
                }
            }
        }
    ]
}
