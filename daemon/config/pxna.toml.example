[core]
listen_addr = "0.0.0.0:6050"
state_dir = "./state"

[logging]
level = "debug" # "trace" | "debug" | "info" | "warn" | "error"
json = false

[web]
dir = "../../ui-web/dist"
# insecure_cookie = true # Drops Secure and __Host-. Only when the path is protected by other means, such as Tailscale

# [scheduler]
# image_slots = 4               # Concurrent image conversions for the viewer and thumbnails
# image_interactive_slots = 1   # Extra conversions only for the image the viewer shows now
# process_slots = 2             # Concurrent ffmpeg and heif-dec runs for images (HEIF, AVIF, JXL, JP2)
# process_interactive_slots = 1 # Extra runs only for the image the viewer shows now
# video_slots = 1               # Concurrent ffmpeg runs for videos, apart from process_slots
# video_interactive_slots = 1   # Extra video runs only for what the viewer shows now

# [media]
# ffmpeg_path = "ffmpeg"
# ffprobe_path = "ffprobe"
# heif_dec_path = "heif-dec" # libheif 1.17 or newer. Used for HEIC/AVIF with alpha and as a fallback; TIFF when built with libtiff (1.19+), level-0 PNG otherwise

# [video]
# max_concurrent_transcodes = 1
# segment_secs = 6
# restart_threshold_segments = 3
# max_height = 1080
# encoder = "libx264"
# encoder_args = ["-preset", "veryfast", "-crf", "23"]
# session_idle_timeout_secs = 300

# [timeline]
# time_zone = "Asia/Tokyo"       # If omitted, TZ or the OS setting is used. Docker defaults to UTC, so set it here or via TZ
# scan_interval_secs = 86400     # Seconds from the end of the last aggregation to the next one. 0 disables periodic aggregation
# max_concurrent_extractions = 1 # Concurrent archive extractions during aggregation
# max_concurrent_probes = 1      # Concurrent ffprobe runs during aggregation

[[libraries]]
id = "photos"
name = "Photos"
path = "./demo/photos"
readonly = false
